@startuml PFE_Class_Diagram

'=================================================
' THEME
'=================================================
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam shadowing false
skinparam roundcorner 15
skinparam BackgroundColor white
skinparam ArrowColor #1e4a49

skinparam class {
    BackgroundColor #FAFAFA
    BorderColor #1e4a49
    HeaderBackgroundColor #1e4a49
    FontColor #FFFFFF
}

'=================================================
' USERS
'=================================================

package "Gestion des Utilisateurs" {

abstract class Utilisateur  {
    +id : bigint
    +nom : string
    +prenom : string
    +courriel : string
    -mot_de_passe : string
    +role : enum
    +created_at : timestamp
    +updated_at : timestamp

    +login()
    +logout()
}

class Etudiant{
    +code_etudiant : string
    +niveau : string
    +groupe : string

    +postuler()
    +deposerLivrable()
}

class Professeur {
    +specialite : string
    +grade : string
    +bureau : string

    +superviserProjet()
}

class Coordinateur{
    +bureau : string

    +validerProjet()
    +genererStats()
}

Utilisateur <|-- Etudiant
Utilisateur <|-- Professeur
Utilisateur <|-- Coordinateur

}

'=================================================
' ACADEMIC STRUCTURE
'=================================================

package "Structure Académique" {

class Departement {
    +id : bigint
    +nom : string
    +description : text
}

class Filiere {
    +id : bigint
    +nom : string
    +description : text
}

class AnneeUniversitaire {
    +id : bigint
    +annee : string
    +date_debut : date
    +date_fin : date
    +statut : enum
}

}

'=================================================
' PROJECT MANAGEMENT
'=================================================

package "Gestion PFE" {

class Projet{
    +id : bigint
    +titre : string
    +description : text
    +domaine : string
    +statut : enum
    +ville : string
    +latitude : decimal
    +longitude : decimal
    +zone_etude : json

    +creer()
    +modifier()
    +archiver()
}

class Postulation {
    +id : bigint
    +statut : enum
    +created_at : timestamp
}

class Depot {
    +id : bigint
    +chemin_fichier : string
    +type_depot : string
    +statut_validation : enum
    +commentaire : text
}

class Soutenance {
    +id : bigint
    +date : date
    +heure : time
    +salle : string
    +jury : text
    +note_finale : decimal
}

}

'=================================================
' GIS MODULE
'=================================================

package "SIG & Cartographie" {

class DonneeSpatiale {
    +id : bigint
    +nom : string
    +geojson : json
    +surface : float
}

class CoucheCarte {
    +id : bigint
    +nom : string
    +type : enum
}

}

'=================================================
' COMMUNICATION
'=================================================

package "Communication & Analytics" {

class Message {
    +id : bigint
    +contenu : text
    +read_at : timestamp
}

class Statistique {
    +id : bigint
    +total_projets : int
    +projets_valides : int
    +projets_par_domaine : json
}

}

'=================================================
' RELATIONS
'=================================================

Departement "1" -- "*" Filiere
Departement "1" -- "*" Utilisateur

Filiere "1" -- "*" Etudiant

Professeur "1" -- "*" Projet : supervise
Coordinateur "1" -- "*" Projet : valide
AnneeUniversitaire "1" -- "*" Projet

Etudiant "1" -- "*" Postulation
Projet "1" -- "*" Postulation

Etudiant "1" -- "*" Depot
Projet "1" -- "*" Depot

Projet "1" -- "0..1" Soutenance

Projet "1" -- "*" DonneeSpatiale
DonneeSpatiale "1" -- "*" CoucheCarte

Utilisateur "1" --> "*" Message : expéditeur
Utilisateur "1" --> "*" Message : destinataire

Coordinateur "1" -- "*" Statistique
AnneeUniversitaire "1" -- "*" Statistique

@enduml
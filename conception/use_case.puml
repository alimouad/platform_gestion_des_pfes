@startuml use_case

left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam shadowing false
skinparam ArrowColor #1e4a49
skinparam usecaseBackgroundColor #f8faef
skinparam usecaseBorderColor #1e4a49

actor "Étudiant" as Etudiant
actor "Professeur" as Prof
actor "Coordinateur" as Coord
actor "Super Administrateur" as Admin

rectangle "Système de Gestion des PFE · GAGE" {

    ' =========================
    ' Authentification
    ' =========================
    usecase "S'authentifier" as UC1
    usecase "Se déconnecter" as UC2
    usecase "Consulter son profil" as UC3

    ' =========================
    ' Étudiant
    ' =========================
    usecase "Consulter les sujets PFE\n(filtrés par département)" as UC4
    usecase "Postuler à un projet" as UC5
    usecase "Déposer les livrables" as UC6
    usecase "Suivre l'état du projet" as UC7
    usecase "Consulter sa soutenance" as UC8
    usecase "Visualiser la carte SIG" as UC9
    usecase "Importer des données SIG" as UC10
    usecase "Envoyer un message\nà l'encadrant" as UC11
    usecase "Consulter les archives PFE" as UC12

    ' =========================
    ' Professeur
    ' =========================
    usecase "Proposer un sujet PFE" as UC13
    usecase "Définir la zone d'étude" as UC14
    usecase "Valider / Rejeter\nles livrables" as UC15
    usecase "Suivre l'avancement" as UC16
    usecase "Visualiser la carte SIG\nde ses projets" as UC17
    usecase "Répondre aux messages\ndes étudiants" as UC18

    ' =========================
    ' Coordinateur
    ' =========================
    usecase "Superviser les projets\n(département uniquement)" as UC19
    usecase "Affecter les étudiants\naux projets" as UC20
    usecase "Organiser les soutenances" as UC21
    usecase "Marquer une soutenance\nterminée" as UC22
    usecase "Consulter les statistiques" as UC23
    usecase "Visualiser la carte SIG\nglobale" as UC24

    ' =========================
    ' Super Admin
    ' =========================
    usecase "Gérer les utilisateurs" as UC25
    usecase "Gérer les départements" as UC26
    usecase "Gérer les filières" as UC27
    usecase "Gérer les années\nuniversitaires" as UC28
    usecase "Gérer les étudiants" as UC29
    usecase "Gérer les professeurs" as UC30
    usecase "Administrer les projets" as UC31
    usecase "Consulter les statistiques\nglobales" as UC32
}

' Commun
Etudiant --> UC1
Prof --> UC1
Coord --> UC1
Admin --> UC1

Etudiant --> UC2
Prof --> UC2
Coord --> UC2
Admin --> UC2

Etudiant --> UC3
Prof --> UC3
Coord --> UC3

' Étudiant
Etudiant --> UC4
Etudiant --> UC5
Etudiant --> UC6
Etudiant --> UC7
Etudiant --> UC8
Etudiant --> UC9
Etudiant --> UC10
Etudiant --> UC11
Etudiant --> UC12

' Professeur
Prof --> UC13
Prof --> UC14
Prof --> UC15
Prof --> UC16
Prof --> UC17
Prof --> UC18

' Coordinateur
Coord --> UC19
Coord --> UC20
Coord --> UC21
Coord --> UC22
Coord --> UC23
Coord --> UC24

' Super Admin
Admin --> UC25
Admin --> UC26
Admin --> UC27
Admin --> UC28
Admin --> UC29
Admin --> UC30
Admin --> UC31
Admin --> UC32

' Include
UC13 .> UC14 : <<include>>
UC11 .> UC18 : <<include>>
UC21 .> UC22 : <<include>>

@enduml
